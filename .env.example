# .env.local로 복사한 뒤 실제 값을 채우세요.

# Neon PostgreSQL 연결 문자열 (Neon 콘솔 > Connect)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/blog?sslmode=require"

# --- Contact 폼 (Resend) ---
# 로컬에서는 비워 두면 메일을 보내지 않고 DB에만 저장합니다. (Production에서는 필수)
# Resend API 키 (https://resend.com/api-keys)
RESEND_API_KEY=""
# 메시지를 받을 주소 (페이지에는 노출되지 않습니다)
CONTACT_TO_EMAIL=""
# 보내는 주소 (선택). 비우면 Resend 테스트 주소(onboarding@resend.dev)를 씁니다.
# 테스트 주소로는 Resend 가입 이메일로만 보낼 수 있으니, 도메인을 인증한 뒤 바꾸세요.
CONTACT_FROM_EMAIL=""
# IP 해시용 비밀값 (선택). 비우면 RESEND_API_KEY를 씁니다.
CONTACT_HASH_SECRET=""
